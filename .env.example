TE_DATABASE_URL=sqlite:///data/tender_enricher.db
TE_INPUT_PATH=data/inbox/tenders.json
TE_OUTPUT_PATH=data/outbox/results.json
TE_REQUEST_INTERVAL_SECONDS=2.0
TE_REQUEST_TIMEOUT_SECONDS=15.0
TE_MAX_ATTEMPTS=3
TE_MAX_RETRY_DELAY_SECONDS=30.0
TE_MAX_PAGES_PER_TENDER=12
TE_BROWSER_ENABLED=false
# Optional, only for URL discovery. Never commit the real key.
TE_BRAVE_API_KEY=
TE_SERPER_API_KEY=
TE_TAVILY_API_KEY=
# Optional operator-controlled SearXNG server; JSON output must be enabled there.
TE_SEARXNG_URL=
TE_SEARXNG_ENGINES=[]
# All configured providers run; omit a provider here to disable it.
TE_SEARCH_PROVIDERS=["brave","serper","tavily","searxng"]
# Source trust is operator configuration, never an input record flag.
TE_OFFICIAL_AWARD_HOSTS=["ekap.kik.gov.tr","kik.gov.tr"]
TE_REGISTRY_HOSTS=["ticaretsicil.gov.tr","www.ticaretsicil.gov.tr"]
